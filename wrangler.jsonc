{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trends",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "trends", "database_id": "06617cb3-44b0-4de4-a3a0-ad7f63177db8" }
  ],
  // 매시 정각: 기기 시간대로 지금이 알림 시각(src/digest.ts PUSH_HOURS)인 기기에 요약 푸시
  "triggers": { "crons": ["0 * * * *"] }
  // secrets (wrangler secret put): (선택) EXPO_ACCESS_TOKEN
}
