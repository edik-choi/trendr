{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trendr",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "trendr", "database_id": "4c5635e7-7c1f-4a66-8d89-a1a76411c024" }
  ],
  // 매시 정각: 기기 시간대로 지금이 알림 시각(src/digest.ts PUSH_HOURS)인 기기에 요약 푸시
  "triggers": { "crons": ["0 * * * *"] }
  // secrets (wrangler secret put): (선택) EXPO_ACCESS_TOKEN
}
